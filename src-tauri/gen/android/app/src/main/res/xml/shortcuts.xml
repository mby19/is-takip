<?xml version="1.0" encoding="utf-8"?>
<!--
  Uygulama simgesine basılı tutunca çıkan kısayol.
  Derin bağlantı (istakip://bugun) ile açılır; uygulama açıkken onNewIntent,
  kapalıyken açılışta getCurrent() üzerinden okunur.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="bugun"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_today_short"
        android:shortcutLongLabel="@string/shortcut_today_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.mby.istakip"
            android:targetClass="com.mby.istakip.MainActivity"
            android:data="istakip://bugun" />
    </shortcut>
</shortcuts>

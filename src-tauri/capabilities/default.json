{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "fs:default",
    "fs:allow-download-read",
    "fs:allow-download-read-recursive",
    "fs:allow-download-write",
    "fs:allow-download-write-recursive",
    "fs:allow-stat",
    "fs:allow-remove"
  ]
}
